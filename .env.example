# Salin file ini menjadi ".env" lalu isi. JANGAN kirim isi .env ke siapa pun (termasuk ke chat).

# --- Wajib ---
# API key dari https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Nomor WhatsApp pribadi Elha untuk menerima draft & eskalasi (format 62812xxxx).
# Boleh sama dengan nomor bisnis: draft akan muncul di chat "Message yourself".
ADMIN_NUMBER=

# Bikin sendiri, bebas (huruf+angka acak, min. 20 karakter)
WAHA_API_KEY=ganti-dengan-teks-acak-panjang-1
WEBHOOK_TOKEN=ganti-dengan-teks-acak-panjang-2
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=ganti-password-dashboard

# --- Perilaku bot ---
# draft = semua balasan dikirim dulu ke Elha untuk disetujui (disarankan di awal)
# auto  = bot membalas client langsung di jam kerja; hal yang perlu keputusan tetap dieskalasi
# off   = bot diam
BOT_MODE=draft
CLAUDE_MODEL=claude-sonnet-5-5
# Jam kerja WIB (Senin-Jumat). Di luar jam ini mode auto berubah jadi draft.
WORK_HOUR_START=9
WORK_HOUR_END=17
# Auto-reply sekali di luar jam kerja (kosongkan jika tidak mau). [ELHA: setujui teksnya]
OUT_OF_HOURS_TEXT=
# Nomor yang tidak boleh dibalas bot (keluarga, teman, tim internal), pisahkan dengan koma
IGNORE_NUMBERS=
# Tunggu N detik setelah pesan terakhir client sebelum membalas (client sering kirim beberapa bubble)
DEBOUNCE_SECONDS=10
# Jika Elha membalas manual dari HP, bot berhenti di chat itu selama N jam
TAKEOVER_PAUSE_HOURS=12
HISTORY_MESSAGES=30
